# ProtonMail Credentials - Choose ONE method below

# ============================================
# METHOD 1: ProtonMail Bridge (RECOMMENDED)
# ============================================
# Use this with protonmail_server_imap.py
# More stable and officially supported

BRIDGE_USERNAME=your-email@protonmail.com
BRIDGE_PASSWORD=your-bridge-password-here

# Optional: Bridge server settings (defaults shown)
PROTON_IMAP_SERVER=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_SERVER=127.0.0.1
PROTON_SMTP_PORT=1025


# ============================================
# METHOD 2: Direct API (DEPRECATED)
# ============================================
# Use this with protonmail_server.py
# May be unreliable due to ProtonMail changes

PROTON_USERNAME=your-email@protonmail.com
PROTON_PASSWORD=your-password-here
PROTON_PGP_PASSWORD=your-pgp-passphrase-if-needed
